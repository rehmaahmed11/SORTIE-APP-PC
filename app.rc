// Windows resources: Explorer icon and the version block shown in file properties.
#include <windows.h>

IDI_ICON1 ICON "assets/icons/app.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AMS"
            VALUE "FileDescription",  "AMS Sortie - floating file sorter"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SortieApp"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Rehman Ahmed (AMS)"
            VALUE "OriginalFilename", "SortieApp.exe"
            VALUE "ProductName",      "AMS Sortie"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Rehman Ahmed  +92 306 0706989"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
